{
  "author": "David Ellis",
  "description": "Module Management Console Server",
  "name": "MMC",
  "version": "0.23.3",
  "license": "MIT",
  "private": true,
  "main": "./main.js",
  "scripts": {
    "lint": "eslint",
    "start": "node ./main.js",
    "test": "./node_modules/.bin/mocha ./unit_tests/*.spec.js --timeout 150000",
    "test:coverage": "c8 npm test",
    "test:functional": "./node_modules/.bin/mocha ./functional_tests/*.spec.js --timeout 30000",
    "test:browser": "playwright test"
  },
  "c8": {
    "all": true,
    "include": [
      "main.js",
      "VLCB-server/**/*.js"
    ],
    "exclude": [
      "unit_tests/**"
    ],
    "reporter": [
      "text",
      "lcov"
    ]
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "cbuslibrary": "^2.12.0",
    "chrome-apps-serialport": "^1.0.9",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "jsonfile": "^6.1.0",
    "morgan": "^1.10.1",
    "openurl": "^1.1.1",
    "serialport": "^12.0.0",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.7.3",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "c8": "^12.0.0",
    "chai": "^4.2.0",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "mocha": "^11.7.4",
    "mocha-param": "^2.0.1"
  }
}
